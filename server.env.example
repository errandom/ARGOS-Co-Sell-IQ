# Fabric SQL Database Backend Server Configuration

# Database Location
FABRIC_DB_SERVER=x6eps4xrq2xudenlfv6naeo3i4-ywxvf76w3u4e5gpdqvtoz57rsa.msit-database.fabric.microsoft.com
FABRIC_DB_PORT=1433
FABRIC_DB_NAME=ARGOS SQL-87da6cf7-5c29-48f5-9b97-b2a3245da352

# Workspace Identity (Service Principal) Authentication
# The backend supports delegated user token mode and workspace identity modes.
#
# Runtime auth options (pick one):
# 0) Delegated user token only: set FABRIC_AUTH_MODE=delegated
# 1) Azure Web App managed identity: set USE_MANAGED_IDENTITY=true
# 2) Client secret: set FABRIC_CLIENT_SECRET
# 3) Federated assertion (runtime workload identity): set OIDC_TOKEN or AZURE_FEDERATED_TOKEN_FILE
#
# Important: GitHub Actions OIDC tokens are available only during workflow execution,
# not while your Azure Web App is running.
FABRIC_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47
FABRIC_CLIENT_ID=df5a4087-2452-4508-9089-c7a0afaa0f5f
FABRIC_CLIENT_SECRET=<get-this-from-entra-app-registration-credentials>
FABRIC_AUTH_MODE=hybrid
# Required in delegated mode. Keep default unless your SQL token audience differs.
FABRIC_DELEGATED_TOKEN_AUDIENCE=https://database.windows.net
USE_MANAGED_IDENTITY=false
# OIDC_TOKEN=
# AZURE_FEDERATED_TOKEN_FILE=

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional: CORS Configuration
CORS_ORIGIN=http://localhost:5173

